{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS - 个人工作与生活管理系统",
  "author": "runlinxin-arch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/runlinxin-arch/lifeosapp"
  },
  "main": "out/main/index.js",
  "build": {
    "appId": "com.lifeos.app",
    "productName": "LifeOS",
    "directories": { "output": "release" },
    "files": ["out/**"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tar": "^6.2.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
